# =================================================================
# NEXO COMPRAS — VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env e configure os valores para o seu ambiente:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. BANCO DE DADOS POSTGRESQL (DOCKER / LOCAL)
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_nexo_secret_2026
POSTGRES_DB=nexo
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# 2. BACKEND (.NET 9 ASP.NET CORE)
# -----------------------------------------------------------------
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# String de Conexão (Utilizada se DATABASE_URL não estiver presente)
# Em ambiente Docker Compose, o host do banco é "postgres"
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=nexo;Username=postgres;Password=postgres_nexo_secret_2026;

# No Railway, a variável DATABASE_URL é provida automaticamente pelo plugin PostgreSQL:
# DATABASE_URL=postgresql://postgres:senha@host:port/railway

# Segurança e Autenticação JWT (Gere uma chave segura com no mínimo 32 caracteres)
JWT_SECRET=NexoComprasSaaSSecretKey2026SuperSecureKeyWith32CharsMin!
JWT_ISSUER=https://nexocompras.com.br
JWT_AUDIENCE=https://app.nexocompras.com.br

# Domínios Permitidos pelo CORS (separados por vírgula)
# No Railway, inclua o domínio público gerado para o frontend (ex: https://nexo-frontend.up.railway.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# -----------------------------------------------------------------
# 3. FRONTEND (REACT / VITE / NGINX)
# -----------------------------------------------------------------
FRONTEND_PORT=5173

# URL pública da API consumida pelo navegador do cliente
# Localmente com Docker Compose: http://localhost:5000/api
# No Railway: https://seu-backend.up.railway.app/api
VITE_API_URL=http://localhost:5000/api
